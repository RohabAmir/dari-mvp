# Pooled connection used by the app at runtime (Neon: the "-pooler" host).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Direct connection used by Prisma for schema pushes.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Any long random string. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me"
# Optional: public URL used inside certificate QR codes. Defaults to the request host.
# NEXT_PUBLIC_APP_URL="https://dari-mvp.vercel.app"
